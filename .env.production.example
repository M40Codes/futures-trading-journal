# Set these in your hosting provider dashboard, not in public code.
NODE_ENV=production
PORT=8000

# Required to protect the hosted journal.
JOURNAL_USERNAME=
JOURNAL_PASSWORD=
SESSION_SECRET=
JOURNAL_DATA_FILE=journal-data.json
TRADOVATE_SESSION_FILE=tradovate-session.json

# demo or live
TRADOVATE_ENV=demo

# Recommended for hosted deployment: set credentials as private environment variables.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=FuturesJournal
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=
TRADOVATE_ACCOUNT_ID=

PORT=8000

# demo or live
TRADOVATE_ENV=demo

# Optional. You can also enter these in the local browser panel.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=FuturesJournal
TRADOVATE_APP_VERSION=1.0

# Required when your Tradovate API setup provides an API key/client id and secret.
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=

# Optional account filter. Leave blank to sync every account visible to the token.
TRADOVATE_ACCOUNT_ID=
